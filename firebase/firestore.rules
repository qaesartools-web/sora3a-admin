rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  منظومة سرعة — قواعد الحماية الموحّدة لكل التطبيقات
//  (الإدارة • المطعم/الكاشير • الكابتن • صفحة التتبع)
//
//  مصدر الصلاحية الوحيد هو مستند users/{uid}، ولا يستطيع أي
//  مستخدم تعديل مستنده بنفسه. الأدوار:
//    admin       إدارة عليا — كل شيء
//    staff       موظف إدارة — قراءة فقط
//    restaurant  مطعم — بيانات مطعمه فقط (users.restaurantId)
//    captain     كابتن — طلباته + الطلبات المعلّقة لمطعمه (users.captainId)
//    cashier     كاشير — يعمل على كاشير مطعمه فقط، وصلاحياته (users.perms)
//                يحددها صاحب المطعم: menu, settings, inventory, reports, cancel, discount
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function me() { return get(userPath()).data; }
    function active() { return hasProfile() && me().get('disabled', false) != true; }
    function role() { return me().role; }

    function isAdmin() { return active() && role() == 'admin'; }
    function isStaff() { return active() && role() == 'staff'; }
    function isOffice() { return isAdmin() || isStaff(); }

    function restDoc(rid) { return get(/databases/$(database)/documents/restaurants/$(rid)).data; }
    // المطعم يجب أن يكون مفعّلاً وغير منتهي الاشتراك
    function restaurantOpen(rid) {
      let r = restDoc(rid);
      return r.get('active', true) != false
        && (r.get('expiryMs', 0) == 0 || r.get('expiryMs', 0) > request.time.toMillis());
    }
    // خدمات المطعم يفتحها ويغلقها المدير الأعلى فقط: captain / calls / whatsapp / pager / online (الافتراضي مفعّلة)
    function feat(rid, k) { return restDoc(rid).get('features', {}).get(k, true) != false; }
    function isRestaurant() {
      return active() && role() == 'restaurant'
        && me().get('restaurantId', '') != ''
        && restaurantOpen(me().restaurantId);
    }
    function myRest() { return me().restaurantId; }
    // الفروع: صاحب المطعم يدير مطعمه + الفروع اللي يربطها له المدير الأعلى (users.branches)
    //  كل فرع مطعم مستقل (منيو، طلبات، كاشيرية، كباتن، اشتراك) — والصلاحية لكل فرع حسب اشتراكه
    function ownsRest(rid) {
      return active() && role() == 'restaurant' && rid is string && rid != ''
        && (me().get('restaurantId', '') == rid || rid in me().get('branches', []))
        && restaurantOpen(rid);
    }

    // دوام الكاشير: hours = {from, to} بالدقائق من منتصف الليل بتوقيت بغداد (UTC+3)
    // بعد نهاية الدوام ١٥ دقيقة سماح لإغلاق الوردية وطباعة التقرير
    // hoursExt.untilMs: تمديد الدوام (الكاشير يختاره لما يخلص وقته: ساعة، ساعتين، ٣، أو لنهاية اليوم) + نفس السماح
    function onDuty() {
      let h = me().get('hours', null);
      let now = (int(request.time.toMillis() / 60000) + 180) % 1440;
      let f = h == null ? 0 : h.from;
      let t = h == null ? 0 : h.to + 15;
      return h == null
        || (f < h.to && ((now >= f && now < t) || now < t - 1440))
        || (f > h.to && (now >= f || now < t))
        || (me().get('hoursExt', {}) is map && me().get('hoursExt', {}).get('untilMs', 0) is int
            && me().get('hoursExt', {}).get('untilMs', 0) + 900000 > request.time.toMillis());
    }
    // تمديد صالح: لحد ٢٠ ساعة قدام بالكثير
    function validExt(e) {
      return e is map && e.keys().hasOnly(['untilMs','atMs','h'])
        && e.untilMs is int && e.untilMs <= request.time.toMillis() + 20 * 3600000
        && (!('atMs' in e) || e.atMs is int) && (!('h' in e) || (e.h is string && e.h.size() <= 8));
    }
    // الكاشير يكدر يمدد بس قرب نهاية دوامه: من نص ساعة قبلها لحد ساعة بعدها (أو خلال تمديد شغّال/خلص قبل أقل من ساعة)
    // وإذا صاحب المطعم لغى التمديد (h = off) ما يرجع يمدد لنفسه نفس اليوم (١٢ ساعة)
    function extWindow(d) {
      let now = (int(request.time.toMillis() / 60000) + 180) % 1440;
      let gap = (now - d.hours.to + 1440) % 1440;
      let e = d.get('hoursExt', {});
      let cancelled = e is map && e.get('h', '') == 'off' && e.get('atMs', 0) is int && e.get('atMs', 0) > request.time.toMillis() - 43200000;
      return !cancelled && (gap < 60 || gap >= 1410
        || (e is map && e.get('untilMs', 0) is int && e.get('untilMs', 0) > request.time.toMillis() - 3600000));
    }
    function validHours(d) {
      return !('hours' in d) || d.hours == null
        || (d.hours is map && d.hours.keys().hasOnly(['from','to'])
            && d.hours.from is int && d.hours.to is int
            && d.hours.from >= 0 && d.hours.from < 1440
            && d.hours.to >= 0 && d.hours.to < 1440 && d.hours.from != d.hours.to);
    }
    function isCashier() {
      return active() && role() == 'cashier'
        && me().get('restaurantId', '') != ''
        && restaurantOpen(me().restaurantId)
        && onDuty();
    }
    function perm(p) { return me().get('perms', {}).get(p, false) == true; }
    // صاحب المطعم أو كاشير تابع له
    function isRestStaff() { return isRestaurant() || isCashier(); }
    function staffOf(rid) { return ownsRest(rid) || cashierOf(rid); }
    function cashierOf(rid) { return isCashier() && myRest() == rid; }

    function isCaptain() {
      return active() && role() == 'captain'
        && me().get('captainId', '') != ''
        && me().get('restaurantId', '') != ''
        && feat(me().restaurantId, 'captain');
    }
    function myCap() { return me().captainId; }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanged(keys) { return changed().hasOnly(keys); }
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || d[k] == null || str(d[k], max); }
    function optNum(d, k) { return !(k in d) || d[k] == null || d[k] is number; }

    // ── users ───────────────────────────────────────────────
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOffice());
      allow list: if isOffice();

      allow create, update, delete: if isAdmin();

      // المطعم ينشئ حسابات الكباتن التابعين له فقط
      allow create: if ownsRest(request.resource.data.restaurantId)
        && request.resource.data.role == 'captain'
        && str(request.resource.data.captainId, 64)
        && request.resource.data.keys().hasOnly(['email','role','name','restaurantId','captainId','createdAtMs']);
      allow update: if ownsRest(resource.data.restaurantId)
        && resource.data.role == 'captain'
        && onlyChanged(['name','email','disabled']);
      allow delete: if ownsRest(resource.data.restaurantId)
        && resource.data.role == 'captain';

      // صاحب المطعم يدير حسابات الكاشيرية وصلاحياتهم
      allow read: if ownsRest(resource.data.restaurantId) && resource.data.role == 'cashier';
      allow create: if ownsRest(request.resource.data.restaurantId)
        && request.resource.data.role == 'cashier'
        && request.resource.data.get('perms', {}) is map
        && validHours(request.resource.data)
        && request.resource.data.keys().hasOnly(['email','role','name','restaurantId','perms','hours','createdAtMs']);
      allow update: if ownsRest(resource.data.restaurantId)
        && resource.data.role == 'cashier'
        && request.resource.data.get('perms', {}) is map
        && validHours(request.resource.data)
        && onlyChanged(['name','perms','disabled','hours','hoursExt'])
        && (!('hoursExt' in request.resource.data) || request.resource.data.hoursExt == null
            || request.resource.data.hoursExt == resource.data.get('hoursExt', null) || validExt(request.resource.data.hoursExt));

      // الكاشير يمدد دوامه بنفسه لما يخلص وقته (ساعة، ساعتين، ٣ ساعات، أو لنهاية اليوم) — وصاحب المطعم يشوفه ويكدر يلغيه
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.role == 'cashier' && resource.data.get('disabled', false) != true
        && resource.data.get('hours', null) != null
        && onlyChanged(['hoursExt'])
        && validExt(request.resource.data.hoursExt)
        && request.resource.data.hoursExt.untilMs > request.time.toMillis()
        && extWindow(resource.data);
      allow delete: if ownsRest(resource.data.restaurantId)
        && resource.data.role == 'cashier';
    }

    // ── staff (قائمة موظفي الإدارة) ──────────────────────────
    match /staff/{id} {
      allow read: if isOffice();
      allow write: if isAdmin();
    }

    // ── restaurants ─────────────────────────────────────────
    match /restaurants/{rid} {
      allow read: if isOffice()
        || (active() && role() in ['restaurant', 'cashier', 'captain'] && me().get('restaurantId', '') == rid)
        || (active() && role() == 'restaurant' && rid in me().get('branches', []));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // المطعم لا يستطيع تعديل الاشتراك أو التفعيل أو ربط الحساب
        || (ownsRest(rid) && !changed().hasAny(
             ['active','expiry','expiryMs','subscription','userId','email','createdAt','createdAtMs','features']));

      // المنيو والإعدادات المتزامنة بين أجهزة المطعم
      //  (ملاحظة: {coll}/{d=**} وليس {sub=**} — الأخير يطابق مستند المطعم نفسه)
      match /{coll}/{d=**} {
        allow read: if isOffice() || staffOf(rid) || (isCaptain() && me().restaurantId == rid);
        allow write: if isAdmin() || ownsRest(rid)
          // الكاشير: البيع يحدّث المخزون الجاهز بالمنيو + الورديات + سجل الزبائن
          || (cashierOf(rid) && (coll in ['menu', 'shifts', 'customers']
              || (coll == 'settings' && perm('settings'))
              || (coll == 'menuImages' && perm('menu'))));
      }
    }

    // ── captains ────────────────────────────────────────────
    match /captains/{cid} {
      allow read: if isOffice()
        || (staffOf(resource.data.restaurantId))
        || (isCaptain() && cid == myCap());
      allow create: if isAdmin()
        || (ownsRest(request.resource.data.restaurantId));
      allow update: if isAdmin()
        || (ownsRest(resource.data.restaurantId)
            && request.resource.data.restaurantId == resource.data.restaurantId)
        // الكابتن يغيّر حالة التوفر فقط
        || (isCaptain() && cid == myCap() && onlyChanged(['available','lastSeenMs']));
      allow delete: if isAdmin() || (ownsRest(resource.data.restaurantId));
    }

    // ── captainLocations ────────────────────────────────────
    match /captainLocations/{cid} {
      allow read: if isOffice()
        || (staffOf(resource.data.restaurantId))
        || (isCaptain() && cid == myCap());
      allow write: if isCaptain() && cid == myCap()
        && request.resource.data.captainId == cid
        && request.resource.data.restaurantId == me().restaurantId
        && request.resource.data.lat is number && request.resource.data.lng is number;
      allow delete: if isAdmin();
    }

    // ── orders ──────────────────────────────────────────────
    match /orders/{oid} {
      function capField() { return resource.data.get('captainId', null); }
      function validNew(d) {
        return staffOf(d.restaurantId)
          && d.value is number && d.value >= 0
          && optNum(d, 'fee')
          && optStr(d, 'customer', 120) && optStr(d, 'phone', 30)
          && optStr(d, 'address', 400) && optStr(d, 'notes', 5000)
          // الدلفري يحتاج خدمة الكابتن مفعّلة
          && (d.get('orderType', 'delivery') != 'delivery' || feat(d.restaurantId, 'captain'));
      }

      allow read: if isOffice()
        || (staffOf(resource.data.restaurantId))
        // الكابتن: طلباته فقط + الطلبات المعلّقة في مطعمه
        //  (الاستعلامات: where captainId == X  أو  where restaurantId == R && status == 'pending')
        || (isCaptain() && resource.data.captainId == myCap())
        || (isCaptain() && resource.data.status == 'pending' && resource.data.restaurantId == me().restaurantId);

      allow create: if isAdmin() || validNew(request.resource.data);

      allow update: if isAdmin()
        || (staffOf(resource.data.restaurantId)
            && request.resource.data.restaurantId == resource.data.restaurantId)

        // قبول الطلب: مرة واحدة فقط (يُنفَّذ داخل transaction)
        || (isCaptain()
            && resource.data.restaurantId == me().restaurantId
            && resource.data.status == 'pending'
            && (capField() == null || capField() == myCap())
            && !(myCap() in resource.data.get('rejectedBy', []))
            && request.resource.data.status == 'accepted'
            && request.resource.data.captainId == myCap()
            && onlyChanged(['status','captainId','captainName','acceptedAtMs','timeline']))

        // رفض الطلب: يضيف نفسه لقائمة الرافضين فقط
        || (isCaptain()
            && resource.data.restaurantId == me().restaurantId
            && resource.data.status == 'pending'
            && (capField() == null || capField() == myCap())
            && request.resource.data.get('rejectedBy', []).hasAll(resource.data.get('rejectedBy', []))
            && request.resource.data.get('rejectedBy', []).size() == resource.data.get('rejectedBy', []).size() + 1
            && (myCap() in request.resource.data.get('rejectedBy', []))
            && onlyChanged(['rejectedBy','rejectNotice','timeline']))

        // تقدّم التوصيل: بالتسلسل وبواسطة الكابتن المعيّن فقط
        || (isCaptain() && capField() == myCap()
            && (
              (resource.data.status == 'accepted' && request.resource.data.status == 'pickup')
              || (resource.data.status == 'pickup' && request.resource.data.status == 'delivering')
              || (resource.data.status == 'delivering' && request.resource.data.status == 'delivered')
            )
            && onlyChanged(['status','pickupAtMs','deliveringAtMs','deliveredAt','deliveredAtMs','hasProof','timeline']));

      allow delete: if isAdmin();
    }

    // ── deliveryProofs (صور إثبات التسليم، منفصلة عن الطلب) ──
    match /deliveryProofs/{oid} {
      function ord() { return get(/databases/$(database)/documents/orders/$(oid)).data; }
      allow read: if isOffice()
        || (staffOf(ord().restaurantId))
        || (isCaptain() && ord().get('captainId', null) == myCap());
      allow create: if isCaptain() && ord().get('captainId', null) == myCap()
        && request.resource.data.image is string && request.resource.data.image.size() < 400000;
      allow delete: if isAdmin();
    }

    // ── tracking (صفحة تتبع الزبون — بيانات محدودة للعامة) ──
    //  لا يوجد هنا هاتف ولا عنوان الزبون. القراءة بالمعرّف فقط (لا list).
    match /tracking/{oid} {
      function ord() { return get(/databases/$(database)/documents/orders/$(oid)).data; }
      function safeKeys() {
        return request.resource.data.keys().hasOnly(
          ['status','restaurantName','captainName','value','fee','lat','lng','locTs','updatedAtMs','restaurantId','captainId']);
      }
      allow get: if true;
      allow list: if false;
      allow write: if safeKeys() && (
        isAdmin()
        || (staffOf(ord().restaurantId))
        || (isCaptain() && ord().get('captainId', null) == myCap()));
      allow delete: if isAdmin() || (staffOf(ord().restaurantId));
    }

    // ── accounting (مخزون وحسابات المطعم) ─────────────────────
    match /accounting/{rid} {
      // الكاشير يحتاجها لخصم المواد عند كل بيع (عرضها بالواجهة حسب صلاحية inventory)
      allow read: if isOffice() || staffOf(rid);
      allow write: if isAdmin() || ownsRest(rid)
        // الكاشير: لا يحذف مواد، ولا يغيّر الوصفات والتكاليف أو المصروفات القديمة
        || (cashierOf(rid) && (resource == null || (
              request.resource.data.get('expenses', []) == resource.data.get('expenses', [])
              && request.resource.data.get('recipes', {}) == resource.data.get('recipes', {})
              && request.resource.data.get('costs', {}) == resource.data.get('costs', {})
              && request.resource.data.get('materials', []).size() >= resource.data.get('materials', []).size())));

      // المصروفات: كل مصروف سجل مستقل. الكاشير يضيف فقط؛ التعديل والحذف للمطعم والإدارة
      match /expenses/{eid} {
        allow read: if isOffice() || staffOf(rid);
        allow create: if (isAdmin() || staffOf(rid))
          && request.resource.data.keys().hasOnly(['cat','amount','note','ts','by','byUid','createdAtMs'])
          && str(request.resource.data.cat, 40)
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && optStr(request.resource.data, 'note', 300) && optStr(request.resource.data, 'by', 60)
          && request.resource.data.ts is int;
        allow update: if (isAdmin() || ownsRest(rid))
          && request.resource.data.keys().hasOnly(['cat','amount','note','ts','by','byUid','createdAtMs','editedBy','editedAtMs'])
          && request.resource.data.amount is number && request.resource.data.amount > 0;
        allow delete: if isAdmin() || ownsRest(rid);
      }
    }

    // ── lineTokens (توكن جوكر لكل خط اتصال — حتى 10 خطوط للمطعم) ──
    //  معرّف المستند = التوكن السري نفسه. الجهاز يستخدمه لإرسال رقم المتصل.
    match /lineTokens/{token} {
      function lineOk(d) {
        return d.keys().hasOnly(['restaurantId','line','label','active','createdAtMs'])
          && str(d.line, 20) && str(d.get('label', ''), 40) && d.active is bool;
      }
      allow read: if isAdmin() || (ownsRest(resource.data.restaurantId));
      allow create: if token.size() >= 24 && lineOk(request.resource.data)
        && (isAdmin() || ownsRest(request.resource.data.restaurantId));
      allow update: if lineOk(request.resource.data)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && (isAdmin() || ownsRest(resource.data.restaurantId));
      allow delete: if isAdmin() || ownsRest(resource.data.restaurantId);
    }

    // ── incomingCalls (مكالمة واردة ← تظهر فوراً بكاشير المطعم) ──
    //  الإنشاء بدون تسجيل دخول لكن بتوكن خط صالح ومفعّل لنفس المطعم.
    match /incomingCalls/{id} {
      function lt() { return get(/databases/$(database)/documents/lineTokens/$(request.resource.data.token)).data; }
      allow create: if request.resource.data.keys().hasOnly(['token','restaurantId','line','number','status','ts'])
        && str(request.resource.data.token, 80) && request.resource.data.token.size() >= 24
        && str(request.resource.data.restaurantId, 64)
        && str(request.resource.data.number, 24) && request.resource.data.number.size() >= 3
        && optStr(request.resource.data, 'line', 20)
        && request.resource.data.status == 'ringing'
        && exists(/databases/$(database)/documents/lineTokens/$(request.resource.data.token))
        && lt().active == true
        && lt().restaurantId == request.resource.data.restaurantId
        // خط الواتساب يحتاج خدمة الواتساب، والخط العادي يحتاج خدمة الاتصال
        && (request.resource.data.get('line', '').matches('.*(واتس|واتساب|[Ww]hats).*')
              ? feat(request.resource.data.restaurantId, 'whatsapp')
              : feat(request.resource.data.restaurantId, 'calls'));
      allow read: if isOffice() || (staffOf(resource.data.restaurantId));
      allow update: if staffOf(resource.data.restaurantId)
        && onlyChanged(['status','takenBy','takenAtMs']);
      allow delete: if isAdmin() || (ownsRest(resource.data.restaurantId));
    }

    // ── pushTokens (توكنات الإشعارات — كل مستخدم يكتب توكنه فقط) ──
    //  تقرأها Cloud Functions فقط (Admin SDK يتجاوز القواعد).
    match /pushTokens/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if hasProfile() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokens','role','captainId','restaurantId','updatedAtMs','native'])
        && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 10
        // native: توكن تطبيق الأندرويد (لما يكون شغّال، المتصفح ما يسجّل — حتى ما يجي إشعارين)
        && (!('native' in request.resource.data) || (request.resource.data.native is string && request.resource.data.native.size() <= 400))
        && request.resource.data.get('role', '') == role()
        && request.resource.data.get('captainId', '') == me().get('captainId', '')
        && (request.resource.data.get('restaurantId', '') == me().get('restaurantId', '')
          || request.resource.data.get('restaurantId', '') in me().get('branches', []));
    }

    // ── leads (طلبات التجربة من موقع سرعة — أي زائر يرسل، المدير الأعلى فقط يقرأ ويدير) ──
    function leadInt(d, k, mx) { return d.get(k, 0) is int && d.get(k, 0) >= 0 && d.get(k, 0) <= mx; }
    function leadStr(d, k, mx) { return d.get(k, '') is string && d.get(k, '').size() <= mx; }
    match /leads/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['owner','restaurant','phone','city','email','kind','services','cashiers','captains','sections','lines','notes','wantsTrial','status','source','createdAt'])
        && request.resource.data.keys().hasAll(['owner','restaurant','phone','status','createdAt'])
        && request.resource.data.owner is string && request.resource.data.owner.size() >= 2 && request.resource.data.owner.size() <= 60
        && request.resource.data.restaurant is string && request.resource.data.restaurant.size() >= 2 && request.resource.data.restaurant.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9+ ]{7,20}$')
        && leadStr(request.resource.data, 'city', 40) && leadStr(request.resource.data, 'email', 100)
        && leadStr(request.resource.data, 'kind', 30) && leadStr(request.resource.data, 'notes', 1000)
        && request.resource.data.get('services', []) is list && request.resource.data.get('services', []).size() <= 10
        && leadInt(request.resource.data, 'cashiers', 50) && leadInt(request.resource.data, 'captains', 200)
        && leadInt(request.resource.data, 'sections', 6) && leadInt(request.resource.data, 'lines', 10)
        && request.resource.data.get('wantsTrial', true) is bool
        && request.resource.data.status == 'new' && request.resource.data.get('source', 'site') == 'site'
        && request.resource.data.createdAt == request.time;
    }

    // ── publicMenus (المنيو الأونلاين: يقرأه أي زبون بالرابط أو QR، ويكتبه المطعم) ──
    //  نسخة عامة من المنيو بدون أي بيانات خاصة (لا تكاليف ولا اشتراك ولا حسابات). الصور بمجموعة img.
    match /publicMenus/{rid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if (isAdmin() || staffOf(rid))
        && request.resource.data.keys().hasOnly(['name','area','phone','on','modes','fee','tables','note','cats','autoTable','updatedAtMs'])
        && str(request.resource.data.get('name', ''), 80) && str(request.resource.data.get('area', ''), 120)
        && str(request.resource.data.get('phone', ''), 30) && str(request.resource.data.get('note', ''), 300)
        && request.resource.data.get('on', false) is bool
        && request.resource.data.get('modes', {}) is map
        && request.resource.data.get('cats', []) is list && request.resource.data.get('cats', []).size() <= 80;
      allow delete: if isAdmin() || ownsRest(rid);
      match /img/{imgId} {
        allow get: if true;
        allow list: if false;
        allow create, update: if (isAdmin() || staffOf(rid))
          && request.resource.data.keys().hasOnly(['data','updatedAtMs'])
          && request.resource.data.data is string && request.resource.data.data.size() < 300000;
        allow delete: if isAdmin() || staffOf(rid);
      }
    }

    // ── webOrders (طلب الزبون من المنيو الأونلاين، أو طلب الويتر ← يستلمه الكاشير ويطبعه للمطبخ) ──
    //  الزبون ينشئ فقط (بدون تسجيل دخول) إذا خدمة «الباركود والمنيو» (online) مفعّلة ونوع الطلب مسموح،
    //  والويتر إذا خدمة «تطبيق الويتر» (waiter) مفعّلة — كل خدمة يشغّلها أو يوقفها المدير الأعلى لوحدها.
    //  يتابع حالة طلبه بالمعرّف (get فقط). الكاشير يعيد حساب الأسعار من منيوه، فما نثق بأسعار الزبون.
    match /webOrders/{id} {
      function pm(r) { return get(/databases/$(database)/documents/publicMenus/$(r)).data; }
      function okNew(d) {
        return d.keys().hasOnly(['restaurantId','source','mode','table','items','customer','phone','address','note','status','total','createdAtMs','waiter','waiterUid','day'])
          && str(d.restaurantId, 64) && d.status == 'new'
          && d.mode in ['table', 'pickup', 'delivery']
          && d.items is list && d.items.size() >= 1 && d.items.size() <= 40
          && optStr(d, 'table', 10) && optStr(d, 'customer', 60) && optStr(d, 'phone', 20)
          && optStr(d, 'address', 300) && optStr(d, 'note', 500) && optNum(d, 'total')
          && optStr(d, 'waiter', 60) && optStr(d, 'day', 10) && d.createdAtMs is int
          && restaurantOpen(d.restaurantId)
          && (d.mode != 'table' || d.get('table', '').size() >= 1)
          && (d.mode == 'table' || d.get('phone', '').matches('^[0-9+ ]{7,20}$'))
          && (d.mode != 'delivery' || (d.get('address', '').size() >= 3 && feat(d.restaurantId, 'captain')));
      }
      allow create: if okNew(request.resource.data) && (
          (request.resource.data.source == 'qr' && feat(request.resource.data.restaurantId, 'online')
            && exists(/databases/$(database)/documents/publicMenus/$(request.resource.data.restaurantId))
            && pm(request.resource.data.restaurantId).get('on', false) == true
            && pm(request.resource.data.restaurantId).get('modes', {}).get(request.resource.data.mode, false) == true)
          || (request.resource.data.source == 'waiter' && request.resource.data.mode == 'table'
            && feat(request.resource.data.restaurantId, 'waiter') && staffOf(request.resource.data.restaurantId)
            && request.resource.data.get('waiterUid', '') == request.auth.uid));
      allow get: if true;
      allow list: if isOffice() || staffOf(resource.data.restaurantId);
      // الاستلام مرة وحدة (new ← accepted/rejected)، وبعدها تتحدث المرحلة بس
      allow update: if staffOf(resource.data.restaurantId) && (
          (resource.data.status == 'new' && request.resource.data.status in ['accepted', 'rejected']
            && onlyChanged(['status','orderId','acceptedBy','acceptedAtMs','reason','stage','stageAtMs','ticket','trackId']))
          || (resource.data.status == 'accepted' && onlyChanged(['stage','stageAtMs','orderId','ticket','trackId'])));
      allow delete: if isAdmin() || ownsRest(resource.data.restaurantId);
    }

    // ── config (إعدادات عامة يقرأها كل حساب فعّال، ويكتبها المدير الأعلى فقط — مثل رابط سيرفر الإشعارات) ──
    match /config/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // ── auditLog (سجل العمليات الحساسة — إضافة فقط) ──────────
    match /auditLog/{id} {
      allow read: if isOffice();
      allow create: if active() && request.resource.data.uid == request.auth.uid;
    }

    // أي شيء آخر ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
